# 登录口令（必填）
NOTE_MD_PASSWORD=change-me

# token 有效期（可选，默认 72h；支持 s/m/h/d）
NOTE_MD_TOKEN_TTL=72h

# 对外映射端口（可选，默认 8080）
NOTE_MD_PORT=8080

# LLM（OpenAI 兼容接口；不配置则 AI 对话不可用，其余功能正常）
OPENAI_BASE_URL=https://your-llm-gateway/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=qwen-plus

# 可选：AI 全局免确认写入（默认关闭，按会话授权）
# NOTE_MD_AI_AUTO_WRITE=1
